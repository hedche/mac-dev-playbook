<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by mac-dev-playbook (tasks/tmux.yml). Do not edit by hand. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>uk.leafbit.tmux-server</string>

    <!-- Opened through LaunchServices rather than run directly, so the tmux
         server belongs to "tmux boot.app" and gets that app's Local Network
         permission (see files/tmux-boot/main.c). open does not pass launchd's
         environment on, hence the explicit --env. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-g</string>
        <string>-a</string>
        <string>{{ tmux_boot_app }}</string>
        <string>--env</string>
        <string>PATH={{ tmux_homebrew_prefix }}/bin:{{ tmux_homebrew_prefix }}/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <string>--stdout</string>
        <string>{{ ansible_env.HOME }}/Library/Logs/tmux-boot.log</string>
        <string>--stderr</string>
        <string>{{ ansible_env.HOME }}/Library/Logs/tmux-boot.log</string>
    </array>

    <!-- Start a headless tmux server at login so continuum restores the last
         saved environment before you open a terminal. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- One-shot. open returns at once; the app stays up alongside the tmux
         server, which daemonises and is not launchd's to supervise. -->
    <key>KeepAlive</key>
    <false/>

    <!-- launchd does not inherit your shell PATH, so tmux and its dependencies
         must be findable here. This is the usual reason these agents silently
         do nothing. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{ tmux_homebrew_prefix }}/bin:{{ tmux_homebrew_prefix }}/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>{{ ansible_env.HOME }}</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{ ansible_env.HOME }}/Library/Logs/tmux-boot.log</string>
    <key>StandardErrorPath</key>
    <string>{{ ansible_env.HOME }}/Library/Logs/tmux-boot.log</string>
</dict>
</plist>
